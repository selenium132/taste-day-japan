# Copy to .env and fill in. Never commit .env. Node 22+: run with `node --env-file=.env dev-server.js`.

# Qloo hackathon key (emailed after the API key request form). Leave empty to run on the sample replay data.
QLOO_API_KEY=
# Optional: QLOO_MODE=replay forces the sample data even when a key is set.
QLOO_MODE=
# Hackathon keys only work on this base URL (staging/production return 401).
QLOO_BASE_URL=https://hackathon.api.qloo.com

# LLM: mock (default, no key) | anthropic | openai (any OpenAI-compatible chat completions API)
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
